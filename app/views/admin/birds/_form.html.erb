<%= form_with model: [ :admin, bird ] do |form| %>
  <% if bird.errors.any? %>
    <div class="errors">
      <p><%= pluralize(bird.errors.count, "error") %> prevented this bird from being saved:</p>
      <ul>
        <% bird.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :common_name %>
    <%= form.text_field :common_name, required: true, autofocus: true %>
  </div>

  <div class="field">
    <%= form.label :scientific_name %>
    <%= form.text_field :scientific_name, required: true %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button" %>
    <%= link_to "Cancel", admin_birds_path %>
  </div>
<% end %>
