<% content_for :title, "Birds" %>

<div class="page-heading">
  <h1>Birds</h1>
  <%= link_to "New bird", new_admin_bird_path, class: "button" %>
</div>

<% if @birds.any? %>
  <table>
    <thead>
      <tr>
        <th>Common name</th>
        <th>Scientific name</th>
        <th>Photos</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @birds.each do |bird| %>
        <tr>
          <td><%= bird.common_name %></td>
          <td><em><%= bird.scientific_name %></em></td>
          <td class="photo-count"><%= bird.photos.size %></td>
          <td class="actions">
            <%= link_to "Edit", edit_admin_bird_path(bird) %>
            <%= button_to "Delete", admin_bird_path(bird), method: :delete,
                  class: "button-link danger",
                  form: { onsubmit: "return confirm('Delete this bird?')" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No birds yet.</p>
<% end %>
