<% content_for :title, "Locations" %>

<div class="page-heading">
  <h1>Locations</h1>
  <%= link_to "New location", new_admin_location_path, class: "button" %>
</div>

<% if @locations.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>State</th>
        <th>Challenge</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @locations.each do |location| %>
        <tr>
          <td><%= location.name %></td>
          <td><%= location.state %></td>
          <td>
            <% if location.challenge %>
              <%= link_to "##{location.challenge.rotation_position}", edit_admin_challenge_path(location.challenge) %>
            <% else %>
              <span class="muted">None</span>
            <% end %>
          </td>
          <td class="actions">
            <%= link_to "Edit", edit_admin_location_path(location) %>
            <%= button_to "Delete", admin_location_path(location), method: :delete,
                  class: "button-link danger",
                  form: { onsubmit: "return confirm('Delete this location?')" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No locations yet.</p>
<% end %>
